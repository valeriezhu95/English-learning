# 服务器配置
NODE_ENV=development
PORT=3000
HOST=localhost

# 数据库配置
MONGODB_URI=mongodb://localhost:27017/english-learning
DB_NAME=english-learning

# 微信公众号配置
WECHAT_APP_ID=your_wechat_app_id
WECHAT_APP_SECRET=your_wechat_app_secret
WECHAT_TOKEN=your_wechat_token

# Google Cloud TTS 配置
GOOGLE_CLOUD_PROJECT_ID=your_project_id
GOOGLE_CLOUD_KEY_FILE=./config/google-cloud-key.json

# 爬虫配置
CRAWLER_SOURCES=bbc,medium,wikipedia
CRAWLER_INTERVAL=3600000
CONTENT_MIN_WORDS=300
CONTENT_MAX_WORDS=500
CONTENT_MIN_GRADE=B1

# 推送配置
PUSH_MORNING_TIME=09:00
PUSH_EVENING_TIME=18:30
TIMEZONE=Asia/Shanghai

# 日志配置
LOG_LEVEL=info
LOG_DIR=./logs

# API 限流
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX_REQUESTS=100
